# Build artifacts — let the image rebuild them fresh
node_modules
dist
build

# Local dev / IDE / VCS
.git
.gitignore
.gitattributes
.vscode
.idea
.DS_Store

# Logs
*.log
npm-debug.log*

# Secrets and per-user runtime config — never bake into the image
.env
.env.*
!.env.example

# Private campaign content shipped only at runtime (mount as volume if needed)
.docs

# Project tooling that has no business inside the image
.claude
rebuild.ps1
rebuild.sh
docker-compose.yml
Dockerfile
.dockerignore
README.md
CLAUDE.md
