# LLM API Keys are now configured per-user in the in-app `虚空连接的设置` panel.
# Keys are persisted to the browser's localStorage and sent with each API call,
# so no server-side LLM credentials are required at boot.

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# NYAACHAT_MCP_TOKEN: Authorization key used to invoke NyaaChat-MCP for
# objective CoC dice rolling. Leave empty to fall back to the in-process
# local roll implementation (no MCP round-trip, results are still random
# and deterministic per-call but generated locally).
NYAACHAT_MCP_TOKEN=""

# IMAGE_PUBLIC_BASE_URL: Public-facing prefix used to build URLs for the
# server-side image cache (clue photos generated by the LLM are persisted to
# cache/images/<sha256>.png and served from /cache/images/<filename>).
#
# - Set this to the URL that other devices / browsers can use to reach your
#   server, e.g. "http://my-host.example.com:3093" or "https://keeper.example.com".
#   The browser ONLY persists imageUrl values that start with this prefix to
#   localStorage — so this is also the allowlist that keeps base64 / third-
#   party URLs out of saves.
# - Leave it EMPTY for a localhost-only deployment. The server will then
#   derive the URL from the incoming request's origin (e.g. http://localhost:3093),
#   which is fine for solo play but means the URLs are not portable across
#   devices.
# - When deploying via docker-compose, this value is read from the project
#   root .env file and passed into the container as an environment variable.
# - When fronted by nginx / Cloudflare / any reverse proxy, set this to the
#   PUBLIC URL (https://...) — see .docs/nginx-reverse-proxy.md for details.
IMAGE_PUBLIC_BASE_URL=""

# TRUST_PROXY: Express `trust proxy` setting. Controls which X-Forwarded-*
# headers the server is willing to honour for req.ip / req.protocol /
# req.hostname / image-public-base-url derivation.
#
# Leave it at the default unless you understand the implications — accepting
# X-Forwarded-* from an untrusted source lets the client spoof their IP /
# scheme / host. Accepted values:
#   (unset / empty) -> "loopback, linklocal, uniquelocal" (default — fits
#                       nginx on the same host and Docker bridge networks)
#   "false"         -> never trust forwarded headers (raw socket only)
#   "true"          -> trust every hop (only safe behind a fully trusted edge)
#   "1" / "2" / ... -> trust the N closest hops
#   "10.0.0.0/8,1.2.3.4" -> explicit CIDR / IP allowlist
TRUST_PROXY=""

# NyaaAcount 统一账号平台凭证（P5+）。
# 每个接入项目（NyaaChat / AVG / Keeper_CoC-TRPG）各有一套独立 token+key。
# 先在 NyaaAcount .env 配好 KEEPER 后缀凭证，再把相同值填到这里（不含后缀）。
#
# Generate token: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Generate key:   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NYAAACOUNT_BASE_URL=http://h.nyaa.host:5110
NYAAACOUNT_API_TOKEN=
NYAAACOUNT_ENCRYPTION_KEY=

# KEEPER_DATA_DIR: Host directory mounted into the container for persistent
# data (SQLite DB, user uploads, etc.). Per workspace Docker large-asset
# policy, production deploys should point this at E:\DockerRes\<project>\.
# Defaults to "." (project root) for local dev — fine for testing, but
# switch to a non-system drive for production to keep large files off the
# system SSD.
KEEPER_DATA_DIR=.

# KEEPER_USER_STORAGE_DIR: Container-internal path for per-user encrypted
# chat-session archives (P7). Bind-mounted from KEEPER_DATA_DIR/user-storage.
# Usually no need to override this default.
# KEEPER_USER_STORAGE_DIR=/data/user-storage
