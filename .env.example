# LLM API Keys are now configured per-user in the in-app `虚空连接的设置` panel.
# Keys are persisted to the browser's localStorage and sent with each API call,
# so no server-side LLM credentials are required at boot.

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# NYAACHAT_MCP_TOKEN: Authorization key used to invoke NyaaChat-MCP for objective CoC dice rolling.
NYAACHAT_MCP_TOKEN=""
